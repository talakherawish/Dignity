{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dignity-academic-hub-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8080,
      "autoPort": true
    },
    {
      "name": "dignity-backend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "dignity-backend",
      "port": 3000
    },
    {
      "name": "dignity-backend-sandbox",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:sandbox"
      ],
      "cwd": "dignity-backend",
      "port": 3000
    }
  ]
}
