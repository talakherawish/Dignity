DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Outgoing email (used to notify Dignity@birzeit.edu of new mailing-list
# signups from the site footer -- see src/collections/Recipients.ts and
# src/lib/emailConfig.ts). Leave unset for local development: emails are
# just logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Dignity Initiative
